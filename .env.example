# Public site configuration. Email, LinkedIn and GitHub have defaults in lib/site.ts;
# set these only to override them.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Contact form delivery (server-only, never exposed to the browser).
# Uses the Resend REST API. If these are unset the form reports that delivery
# is not configured and offers an email link instead of faking success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Admin CMS (server-only). Production needs all three; local development needs only `npm run setup:local`,
# which generates AUTH_SECRET in .env.local and uses an embedded database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AUTH_SECRET=
# Optional: enables GET /api/cron/publish-scheduled (send as `Authorization: Bearer <value>`). 16+ random characters.
CRON_SECRET=

# Local / testing only. Never set on a real deployment:
# ALLOW_LOCAL_DB=1
# PGLITE_DIR=.data/e2e
# NEXT_DIST_DIR=.next-e2e
